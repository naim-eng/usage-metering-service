# Use local for development and isolated testing.
# Use production only for an actual production deployment.
DEPLOYMENT_ENV=local

# Production requires a verified trusted reverse proxy.
# Set to 1 only after implementing the ingress security contract.
PRODUCTION_INGRESS_CONFIGURED=0

# Production API rate limiting currently requires one replica.
API_REPLICA_COUNT=1

DB_HOST=localhost
DB_PORT=5433
DB_USER=metering
DB_PASSWORD=replace_with_your_password
DB_NAME=usage_metering

# PostgreSQL connection configuration
# Connection timeout in milliseconds (100-60000).
DB_CONNECT_TIMEOUT_MS=5000

# Maximum database connections per application pool (1-100).
# Each application replica may create its own pool.
DB_POOL_MAX=10

# Use disable for local PostgreSQL without TLS.
# Use verify-full only with a verified production TLS configuration.
DB_SSL_MODE=disable

# Optional path to a trusted PostgreSQL CA certificate.
# Requires DB_SSL_MODE=verify-full.
# Currently supported by pg, but not by the Prisma adapter.
# Leave unset unless custom CA support is implemented for Prisma.
# DB_SSL_ROOT_CERT=/path/to/postgresql-ca.pem

# Structured application logging
# Supported levels: fatal, error, warn, info, debug, trace, silent.
# Use info for normal production operation.
# Avoid debug/trace unless temporarily troubleshooting.
LOG_LEVEL=info

PORT=3000
ADMIN_API_KEY=replace_with_your_admin_key

# Reverse proxy configuration
# Keep disabled for direct local connections.
# In production, specify only verified trusted proxy IPs/CIDR ranges.
# Example: TRUST_PROXY=192.0.2.10/32
# Do not use true, numeric hop counts, or unrestricted CIDR ranges.
TRUST_PROXY=false
