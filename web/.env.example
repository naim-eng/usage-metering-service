# Use local for development and isolated testing.
# Use production only for an actual production deployment.
DEPLOYMENT_ENV=local

# Production requires trusted ingress and client IP header sanitization.
# Set to 1 only after implementing the ingress security contract.
PRODUCTION_INGRESS_CONFIGURED=0

# Server-side PostgreSQL connection for customer authentication
AUTH_DATABASE_URL=postgresql://USERNAME:PASSWORD@127.0.0.1:5433/usage_metering

# Generate a strong random secret for your actual environment
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Next.js frontend URL
BETTER_AUTH_URL=http://localhost:3002

# Server-side metering API connection
METERING_API_URL=http://localhost:3000

# Must match ADMIN_API_KEY in the backend environment
METERING_ADMIN_API_KEY=replace_with_your_admin_key

# Optional comma-separated additional trusted origins
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3002

# Local email delivery through Mailpit.
# Start: docker compose -f docker-compose.mail.yml up -d
# Inbox: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@example.test
SMTP_USER=
SMTP_PASSWORD=

# Production requires a real SMTP hostname, sender and credentials.
# Use port 587 with SMTP_SECURE=false for mandatory STARTTLS,
# or port 465 with SMTP_SECURE=true for implicit TLS.
