generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                                     BigInt               @id @default(autoincrement())
  name                                   String               @db.VarChar(100)
  api_key_hash                           String               @unique @db.VarChar(64)
  plan_id                                BigInt
  created_at                             DateTime             @default(now()) @db.Timestamptz(6)
  plans_accounts_plan_idToplans          plans                @relation("accounts_plan_idToplans", fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  monthly_usage                          monthly_usage[]
  plan_limit_history                     plan_limit_history[]
  plans_plans_owner_account_idToaccounts plans[]              @relation("plans_owner_account_idToaccounts")
  usage_requests                         usage_requests[]
  users                                  users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model monthly_usage {
  id                                            BigInt   @id @default(autoincrement())
  account_id                                    BigInt
  user_id                                       BigInt?
  month_start                                   DateTime @db.Date
  units_used                                    BigInt   @default(0)
  created_at                                    DateTime @default(now()) @db.Timestamptz(6)
  users_monthly_usage_account_id_user_idTousers users?   @relation("monthly_usage_account_id_user_idTousers", fields: [account_id, user_id], references: [account_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_monthly_usage_user_account")
  accounts                                      accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_monthly_usage_user_idTousers            users?   @relation("monthly_usage_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model plan_limit_history {
  id              BigInt   @id @default(autoincrement())
  account_id      BigInt
  user_id         BigInt?
  plan_id         BigInt
  plan_name       String   @db.VarChar(100)
  monthly_limit   BigInt
  max_per_request BigInt
  effective_at    DateTime @default(now()) @db.Timestamptz(6)
  change_type     String   @db.VarChar(30)
  users           users?   @relation(fields: [account_id, user_id], references: [account_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_plan_history_user_account")
  accounts        accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plans           plans    @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id, effective_at(sort: Desc), id(sort: Desc)], map: "idx_plan_history_account_time")
  @@index([account_id, user_id, effective_at(sort: Desc), id(sort: Desc)], map: "idx_plan_history_user_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model plans {
  id                                        BigInt               @id @default(autoincrement())
  name                                      String               @db.VarChar(100)
  plan_type                                 String               @db.VarChar(20)
  owner_account_id                          BigInt?
  monthly_limit                             BigInt
  max_per_request                           BigInt
  created_at                                DateTime             @default(now()) @db.Timestamptz(6)
  accounts_accounts_plan_idToplans          accounts[]           @relation("accounts_plan_idToplans")
  plan_limit_history                        plan_limit_history[]
  accounts_plans_owner_account_idToaccounts accounts?            @relation("plans_owner_account_idToaccounts", fields: [owner_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_plan_owner")
  users                                     users[]

  @@index([owner_account_id, plan_type], map: "idx_plans_owner")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usage_requests {
  id                                             BigInt   @id @default(autoincrement())
  account_id                                     BigInt
  user_id                                        BigInt
  request_id                                     String   @db.VarChar(100)
  units_requested                                BigInt
  accepted                                       Boolean
  rejection_scope                                String?  @db.VarChar(20)
  rejection_rule                                 String?  @db.VarChar(50)
  created_at                                     DateTime @default(now()) @db.Timestamptz(6)
  account_remaining_after                        BigInt?
  user_remaining_after                           BigInt?
  users_usage_requests_account_id_user_idTousers users    @relation("usage_requests_account_id_user_idTousers", fields: [account_id, user_id], references: [account_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usage_request_user_account")
  accounts                                       accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_usage_requests_user_idTousers            users    @relation("usage_requests_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([account_id, request_id])
  @@index([account_id, created_at(sort: Desc), id(sort: Desc)], map: "idx_usage_requests_history")
  @@index([account_id, user_id, created_at(sort: Desc)], map: "idx_usage_requests_user_history")
}

model users {
  id                                                      BigInt               @id @default(autoincrement())
  account_id                                              BigInt
  external_user_id                                        String               @db.VarChar(100)
  plan_id                                                 BigInt
  created_at                                              DateTime             @default(now()) @db.Timestamptz(6)
  monthly_usage_monthly_usage_account_id_user_idTousers   monthly_usage[]      @relation("monthly_usage_account_id_user_idTousers")
  monthly_usage_monthly_usage_user_idTousers              monthly_usage[]      @relation("monthly_usage_user_idTousers")
  plan_limit_history                                      plan_limit_history[]
  usage_requests_usage_requests_account_id_user_idTousers usage_requests[]     @relation("usage_requests_account_id_user_idTousers")
  usage_requests_usage_requests_user_idTousers            usage_requests[]     @relation("usage_requests_user_idTousers")
  accounts                                                accounts             @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plans                                                   plans                @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([account_id, id], map: "unique_user_account_pair")
  @@unique([account_id, external_user_id])
  @@index([account_id], map: "idx_users_account")
}
