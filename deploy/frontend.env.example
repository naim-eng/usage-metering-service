# Production frontend configuration.
# Replace placeholders before deployment.

DEPLOYMENT_ENV=production
NODE_ENV=production

# Enable only after ingress verification.
PRODUCTION_INGRESS_CONFIGURED=0

AUTH_DATABASE_URL=postgresql://metering:REPLACE_PASSWORD@db.example.invalid:5432/usage_metering?sslmode=verify-full

BETTER_AUTH_SECRET=replace_with_independent_auth_secret
BETTER_AUTH_URL=https://app.example.invalid
BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.invalid

METERING_API_URL=https://api.example.invalid
METERING_ADMIN_API_KEY=replace_with_production_admin_key

SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=no-reply@example.invalid
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
