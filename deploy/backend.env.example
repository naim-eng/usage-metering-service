# Production backend configuration.
# Replace placeholders before deployment.

DEPLOYMENT_ENV=production
NODE_ENV=production

# Enable only after ingress verification.
PRODUCTION_INGRESS_CONFIGURED=0
API_REPLICA_COUNT=1
TRUST_PROXY=192.0.2.10/32

DB_HOST=db.example.invalid
DB_PORT=5432
DB_USER=metering
DB_PASSWORD=replace_with_production_database_password
DB_NAME=usage_metering
DB_CONNECT_TIMEOUT_MS=5000
DB_POOL_MAX=10
DB_SSL_MODE=verify-full

LOG_LEVEL=info
PORT=3000
ADMIN_API_KEY=replace_with_production_admin_key

# Optional private database CA, mounted read-only.
# DB_SSL_ROOT_CERT=/run/certificates/database-ca.pem
